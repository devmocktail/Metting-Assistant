# Copy to .env and fill in. All values have safe local defaults EXCEPT in production.

# --- Server ---
PORT=8787
# NODE_ENV=production   # in production this forces real secrets (no dev defaults)

# --- Auth mode ---
# stub  = accept idToken "stub:<email>:<name>" (LOCAL/TEST ONLY, no real Google)
# google = verify real Google ID tokens (production)
AUTH_MODE=stub

# --- Google OAuth (required when AUTH_MODE=google) ---
# Create at https://console.cloud.google.com → APIs & Services → Credentials →
# OAuth client ID → "Desktop app". Paste the client id (and secret) here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Session + admin secrets (REQUIRED in production; random dev values used otherwise) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ADMIN_TOKEN=
# Comma-separated admin emails; these are auto-approved and may use the admin API/page.
ADMIN_EMAILS=sankararavind565@gmail.com

# --- Session / heartbeat tuning (ms) ---
SESSION_TTL_MS=604800000          # 7 days
HEARTBEAT_INTERVAL_MS=120000      # app re-checks /me every 2 min
OFFLINE_GRACE_MS=600000           # keep last-approved for 10 min offline, then lock

# --- Storage ---
# json    = data/users.json on local disk (default; needs a persistent disk)
# mysql   = MySQL/MariaDB (recommended on Hostinger; survives Git redeploys)
# upstash = Upstash Redis via REST (free, persistent; good for Render/serverless)
# memory  = in-memory only (tests)
STORE=json
DATA_DIR=./data
# When STORE=upstash:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# When STORE=mysql (create the DB + user in Hostinger hPanel → MySQL Databases):
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# --- Dev sign-in guard (optional) ---
# If set, stub sign-in requires header X-Dev-Auth to match. Leave blank for open local dev.
DEV_AUTH_SECRET=
